[0.681, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[5GF\u001b[8Gm Feed (FF)\u001b[20G    \u001b[28G12\u001b[37GC\u001b[42G\u001b[38;5;153mf\r\u001b[4C\u001b[2B\u001b[39mCarriag\u001b[13G Return\u001b[21G(CR)\u001b[29G3\u001b[37GD\u001b[42G\u001b[38;5;153mr\r\u001b[4C\u001b[2B\u001b[39mSpace (SP)  \u001b[18G    \u001b[28G32\u001b[36G20\u001b[41G\u001b[38;5;153m' '\u001b[45G\u001b[39m(no\u001b[49Gescape)\r\u001b[2C\u001b[1B└\u001b[26G┴\u001b[32G┴\u001b[39G┴\u001b[57G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese six are what C's \u001b[38;5;153misspace()\u001b[39m and regex \u001b[38;5;153m\\s\u001b[39m match in ASCII.\u001b[65GSome\u001b[70Gcontexts\u001b[79Galso\u001b[84Gtreat\u001b[90Gthe\r\u001b[2C\u001b[1Bsep\u001b[8Gators\u001b[14G28–31 (0x1C–0x\u001b[29GF)\u001b[32Gas whitespace,\u001b[47Gfor\u001b[51Gexample\u001b[59GPython's\u001b[68G\u001b[38;5;153mstr.isspace()\u001b[82G\u001b[39mand\u001b[86GJava's\r\u001b[2C\u001b[1B\u001b[38;5;153mCharacter.isWhitespace\u001b[39m. They have no standard escapes.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m✻\u001b[3GCrunched for 3s · done 12:49 PM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mUnrelated: in one sentence, why do Windows text files end lines with CRLF?\u001b[39m                        \r\u001b[2C\u001b[1B\u001b[49m          \u001b[14G     \u001b[20G           \u001b[32G  \u001b[35G           \u001b[47G   \u001b[51G       \u001b[59G        \u001b[68G        "]
[0.003, "o", "     \u001b[82G   \u001b[86G      \u001b[95G\u001b[1m[ 📌 ]\r\u001b[1B\u001b[22m\u001b[38;5;231m⏺\u001b[3G\u001b[39mWindows inherited CRLF from MS-DOS, which inherited it\u001b[58Gfrom\u001b[63GCP/M,\u001b[69Gwhich\u001b[75Gcopied\r\u001b[2C\u001b[1Bteletype-style\u001b[18Gprinters\u001b[27Gwhere\u001b[33GCR\u001b[36Greturned\u001b[45Gthe\u001b[49Gcarriage\u001b[58Gto\u001b[61Gthe\u001b[65Gleft\u001b[70Gmargin\u001b[77Gand\u001b[81GLF\u001b[84Gadvanced\r\u001b[1B \u001b[3Gthe paper, so both were needed to\u001b[37Gstart\u001b[43Ga\u001b[45Gnew\u001b[49Gline.\r\u001b[2B\u001b[38;5;246m✻\u001b[39m \u001b[38;5;246mChurned for 2s · done 12:49 PM\u001b[39m\u001b[K\r\u001b[94C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mAnd in one sentence, how do I make cat show tabs visibly?\u001b[39m                                         \r\u001b[2C\u001b[1B\u001b[49m              \u001b[18G        \u001b[27G     \u001b[33G  \u001b[36G        \u001b[45G   \u001b[49G        \u001b[58G  \u001b[61G   \u001b[65G    \u001b[70G      \u001b[77G   \u001b[81G  \u001b[84G        \u001b[95G\u001b[1m[ 📌 ]\r\u001b[1B\u001b[22m\u001b[38;5;231m⏺\u001b[3G\u001b[39mUs\u001b[7G\u001b[38;5;153mcat -T file\u001b[39m on\u001b[22GGNU/Linux (tabs show\u001b[44Gs \u001b[38;5;153m^I\u001b[39m), or \u001b[38;5;153mcat -t file\u001b[66G\u001b[39mon\u001b[69GmacOS/BSD,\u001b[80Gwhich\u001b[86Galso\r\u001b[2C\u001b[1Bmakes\u001b[9Gother\u001b[15Gcon"]

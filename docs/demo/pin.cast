[0.093, "o", "\u001b[?2026h\u001b[?25l\u001b[H \u001b[3G├\u001b[26G┼\u001b[32G┼\u001b[39G┼\u001b[57G┤\r\u001b[4C\u001b[1BHorizontal Tab\u001b[20G(HT)\u001b[28G9  \u001b[34G0x09\u001b[41G\u001b[38;5;153m\\t\u001b[45G\u001b[39m      \r\u001b[4C\u001b[2BLine Feed (LF)\u001b[20G    \u001b[28G10\u001b[37GA\u001b[42G\u001b[38;5;153mn\r\u001b[4C\u001b[2B\u001b[39mVertical Tab (VT)\u001b[29G1\u001b[37GB\u001b[42G\u001b[38;5;153mv\r\u001b[4C\u001b[2B\u001b[39mFo\u001b[8Gm Feed (FF)   \u001b[29G2\u001b[37GC\u001b[42G\u001b[38;5;153mf\r\u001b[4C\u001b[2B\u001b[39mCa\u001b[8Griag\u001b[13G Return\u001b[21G(CR)\u001b[29G3\u001b[37GD\u001b[42G\u001b[38;5;153mr\r\u001b[4C\u001b[2B\u001b[39mSpace (SP)     \u001b[21G    \u001b[28G32\u001b[36G20\u001b[41G\u001b[38;5;153m' '\u001b[45G\u001b[39m(no\u001b[49Gescape)\r\u001b[2C\u001b[1B└\u001b[26G┴\u001b[32G┴\u001b[39G┴\u001b[57G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese six are what C's \u001b[38;5;153misspace()\u001b[39m and regex \u001b[38;5;153m\\s\u001b[39m match in ASCII.\u001b[65GSome\u001b[70Gcontexts\u001b[79Galso\u001b[84Gtreat\u001b[90Gthe\r\u001b[2C\u001b[1Bseparators\u001b[14G28–31\u001b[20G(0x1C–0x1F)\u001b[32Gas\u001b[35Gwhitespace,\u001b[47Gfor\u001b[51Gexample\u001b[59GPython's\u001b[68G\u001b[38;5;153mstr.isspace()\u001b[82G\u001b[39mand\u001b[86GJava's\r\u001b[2C\u001b[1B\u001b[38;5;153mCharacter.isWhitespace\u001b[39m. They have \u001b[38Go\u001b[40Gstandard\u001b[49Gescapes.\u001b[58G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m✻\u001b[3GCrunched for 3s · done 12:49 "]
[0.001, "o", "PM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mUnrelated: in one sentence, why do Windows text files end lines with CRLF?\u001b[39m                        \r\u001b[94C\u001b[1B\u001b[49m\u001b[1m[ 📌 ]\r\u001b[1B\u001b[22m\u001b[38;5;231m⏺\u001b[39m Windows inherited CRLF from MS-DOS, which inherited it from CP/M, which copied\u001b[K\r\u001b[2C\u001b[1Bteletype-style\u001b[18Gprinters\u001b[27Gwhere\u001b[33GCR\u001b[36Greturned\u001b[45Gthe\u001b[49Gcarriage\u001b[58Gto\u001b[61Gthe\u001b[65Gleft\u001b[70Gmargin\u001b[77Gand\u001b[81GLF\u001b[84Gadvanced\u001b[95G\u001b[K\r\u001b[1B \u001b[3Gthe paper, so both were needed to start a\u001b[45Gnew l\u001b[51Gn\u001b[53G.\u001b[55G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m✻\u001b[3GChurned for 2s · done 12:49 PM\u001b[34G\u001b[39m\u001b[K\r\u001b[2B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mAnd in one sentence, how do I make cat show tabs visibly?\u001b[39m                                         \r\u001b[2B\u001b[49m\u001b[38;5;231m⏺\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]

[0.016, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3G├─────────┼────────────────────────────────────────────────┼───────┼─────────┤\r\u001b[2C\u001b[1B│\u001b[5GONB-303\u001b[13G│\u001b[15GIntegrate\u001b[25GID\u001b[28Gverification\u001b[41Gprovider\u001b[62G│\u001b[64GNadia\u001b[70G│\u001b[72Gblocked\u001b[80G│\u001b[95G\u001b[K\r\u001b[1B \u001b[3G├\u001b[13G┼\u001b[62G┼\u001b[70G┼\u001b[80G┤\r\u001b[4C\u001b[1BONB-304\u001b[15GAdd\u001b[19Gprogress\u001b[28Gtracker to onboarding\u001b[50Gchecklist\u001b[64GBe\u001b[67G  \u001b[72Gopen  \r\u001b[2C\u001b[1B└\u001b[13G┴\u001b[62G┴\u001b[70G┴\u001b[80G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m✻\u001b[3GCrunched for 1s · done 1:30 PM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mHow many tickets in my pinned message are blocked, and who owns them?\u001b[39m                             \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;114m⏺\u001b[3G\u001b[39m\u001b[1mpin-message - get_pinned_message (MCP)\u001b[22m\u001b[K\r\u001b[1B\u001b[38;5;246m  ⎿  \u001b[39mSummary:\u001b[15GCheckout ticket status:\u001b[39Gfour items, one blocked,\u001b[64Gone\u001b[68Gdone\u001b[K\r\u001b"]
[0.013, "o", "[2C\u001b[1B\u001b[K\r\u001b[5C\u001b[1B|\u001b[8Gid\u001b[11G|\u001b[13Gtitle\u001b[19G|\u001b[21Gowner\u001b[27G|\u001b[29Gstatus\u001b[36G|\r\u001b[1B \u001b[3G   \u001b[2m… +5 lines\u001b[22m\u001b[K\r\u001b[94C\u001b[1B\u001b[1m[ 📌 ]\r\u001b[1B\u001b[22m\u001b[38;5;231m⏺\u001b[39m Your pinned message is the checkout table. It has \u001b[1m1 blocked ticket\u001b[22m:\u001b[K\r\u001b[2B \u001b[3G- \u001b[1mCHK-102\u001b[22m, \"Fix tax calculation for EU\u001b[42Gaddresses\",\u001b[54Gowned\u001b[60Gby\u001b[63G\u001b[1mMarcus\r\u001b[1B\u001b[22m\u001b[K\r\u001b[1B\u001b[38;5;246m✻\u001b[3GChurned for 4s · done 1:30 PM\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mList just those blocked tickets and pin that instead.\u001b[39m                                             \r\u001b[94C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;114m⏺\u001b[3G\u001b[39m\u001b[1mpin-message - pin_message (MCP)\u001b[22m(text: \"Blocked checkout tickets\\n\\n|\u001b[72Gid\u001b[75G|\u001b[77Gtitle\u001b[83G|\u001b[85Gowner\u001b[91G|\u001b[93Gstatus\r\u001b[33C\u001b[1B|\\n|---|---|---|---|\\n|\u001b[58GCHK-102\u001b[66G|\u001b[68GFix\u001b[72Gtax\u001b[76Gcalculation\u001b[88Gfor\u001b[92GEU\r\u001b[2C\u001b[1B \u001b[5G        \u001b[14G    \u001b[19G   \u001b[23G           add\u001b[38Gesses | Marcus | blocked\u001b[63G|\")\u001b[K\r\u001b[1B\u001b[38;5;246m  ⎿  \u001b[39mPinned.\r\u001b[1B \u001b[3G                     "]

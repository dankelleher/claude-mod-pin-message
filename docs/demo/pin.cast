[0.729, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1BThese six ar\u001b[16G what \u001b[23G's\u001b[26G\u001b[38;5;153misspace()\u001b[39m and regex\u001b[46G\u001b[38;5;153m\\s\u001b[49G\u001b[39mmatch\u001b[55Gin ASCII.\u001b[65GSome\u001b[70Gcontexts\u001b[79Galso\u001b[84Gtreat\u001b[90Gthe\r\u001b[2C\u001b[1Bseparators 28–31 (0x1C–0x1F) as whitespace, for example\u001b[59GPython's\u001b[68G\u001b[38;5;153mstr.isspace()\u001b[82G\u001b[39mand\u001b[86GJava's\r\u001b[2C\u001b[1B\u001b[38;5;153mCharacter.isWhitespace\u001b[39m. They\u001b[32Ghave no standard\u001b[55Gs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m✻\u001b[3GCrunched for 3s · done 12:49 PM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mUnrelated: in one sentence, why do Windows text files end lines with CRLF?\u001b[39m                        \r\u001b[2C\u001b[1B\u001b[49m                       \u001b[27G    \u001b[32G    \u001b[37G  \u001b[40G        \u001b[49G        \u001b[95G\u001b[1m[ 📌 ]\r\u001b[1B\u001b[22m\u001b[38;5;231m⏺\u001b[3G\u001b[39mWindows\u001b[11Ginherited\u001b[21GCRLF\u001b[26Gfrom\u001b[31GMS-DOS,\u001b[39Gwhich\u001b[45Ginherited\u001b[55Git\u001b[58Gfrom\u001b[63GCP/M,\u001b[69Gwhich\u001b[75Gcopied\r\u001b[1B \u001b[3Gteletype-style printers where CR\u001b[36Greturned\u001b[45Gthe\u001b[49Gcarriage\u001b[58Gto\u001b[61Gthe\u001b[65Gleft\u001b[70Gmargin\u001b[77Gan"]
[0.002, "o", "d\u001b[81GLF\u001b[84Gadvanced\r\u001b[2C\u001b[1Bthe\u001b[7Gpaper,\u001b[14Gso\u001b[17Gboth\u001b[22Gwere\u001b[27Gneeded\u001b[34Gto\u001b[37Gstart\u001b[43Ga\u001b[45Gnew\u001b[49Gline.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m✻\u001b[3GChurned for 2s · done 12:49 PM\u001b[95G\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mAnd in one sentence, how do I make cat show tabs visibly?\u001b[39m                                         \r\u001b[2C\u001b[1B\u001b[49m   \u001b[7G      \u001b[14G  \u001b[17G    \u001b[22G    \u001b[27G      \u001b[34G  \u001b[37G     \u001b[43G \u001b[45G   \u001b[49G     \u001b[95G\u001b[1m[ 📌 ]\r\u001b[1B\u001b[22m\u001b[38;5;231m⏺\u001b[3G\u001b[39mUse\u001b[7G\u001b[38;5;153mcat -T file\u001b[19G\u001b[39mon\u001b[22GGNU/Linux\u001b[32G(tabs\u001b[38Gshow\u001b[43Gas\u001b[46G\u001b[38;5;153m^I\u001b[39m),\u001b[51Gor\u001b[54G\u001b[38;5;153mcat -t file\u001b[66G\u001b[39mon\u001b[69GmacOS/BSD,\u001b[80Gwhich\u001b[86Galso\r\u001b[1B \u001b[3Gmakes other control characters\u001b[34Gvisible.\u001b[43GIf\u001b[46Gyou\u001b[50Galso\u001b[55Gwant\u001b[60Gline\u001b[65Gendings\u001b[73Gmarked\u001b[80Gwith\u001b[85G\u001b[38;5;153m$\u001b[39m,\u001b[88Guse\u001b[92G\u001b[38;5;153mcat\r\u001b[2C\u001b[1B-A file\u001b[11G\u001b[39m(GNU)\u001b[17Gor\u001b[20G\u001b[38;5;153mcat -et file\u001b[33G\u001b[39m(macOS).\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m✻\u001b[3GSautéed for 1s · done 12:49 PM\u001b[95G\u001b[39m\u001b["]
[0.002, "o", "K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mOne more: in one sentence, what does dos2unix do?\u001b[39m                                                 \r\u001b[2C\u001b[1B\u001b[49m       \u001b[11G     \u001b[17G  \u001b[20G            \u001b[33G        \u001b[95G\u001b[1m[ 📌 ]\r\u001b[1B\u001b[22m\u001b[38;5;231m⏺\u001b[3G\u001b[38;5;153mdos2unix\u001b[12G\u001b[39mconverts\u001b[21Ga\u001b[23Gtext\u001b[28Gfile's\u001b[35GWindows-style\u001b[49GCRLF\u001b[54Gline\u001b[59Gendings\u001b[67Gto\u001b[70GUnix-style\u001b[81GLF\u001b[84G(it\u001b[88Gstrips\r\u001b[1B \u001b[3Gthe \u001b[38;5;153m\\r\u001b[39m), and its counterpart \u001b[38;5;153munix2dos\u001b[41G\u001b[39mdoes\u001b[46Gthe\u001b[50Greverse.\r\u001b[2B\u001b[38;5;246m✻\u001b[39m \u001b[38;5;246mSautéed for 1s · done 12:49 PM\u001b[39m\u001b[K\r\u001b[94C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mUsing my pinned message, what are the hex codes for vertical tab and form feed?\u001b[39m                   \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;174m✽\u001b[3G\u001b[38;5;216mZ\u001b[38;5;174mesting… \r\u001b[1B\u001b[38;5;246m  ⎿  Tip:\u001b[11GD\u001b[13Guble-tap esc to rewind the code and/or conversation to a previous point in time\r\u001b[4B❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;5;246m · esc to interrupt · "]

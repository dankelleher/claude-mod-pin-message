[0.243, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3G                                                       \u001b[94G\u001b[1m[ 📌✓ ]\r\u001b[1B\u001b[22m\u001b[38;5;231m⏺\u001b[3G\u001b[39m┌──────────────────────┬─────┬──────┬─────────────────┐\r\u001b[2C\u001b[1B│         Name         │ Dec │ Hex  │     Escape      │\r\u001b[2C\u001b[1B├──────────────────────┼─────┼──────┼─────────────────┤\r\u001b[2C\u001b[1B│ Horizontal Tab (HT)  │ 9   │ 0x09 │ \u001b[38;5;153m\\t\u001b[39m              │\r\u001b[2C\u001b[1B├──────────────────────┼─────┼──────┼─────────────────┤\r\u001b[2C\u001b[1B│ Line Feed (LF)       │ 10  │ 0x0A │ \u001b[38;5;153m\\n\u001b[39m              │\r\u001b[2C\u001b[1B├──────────────────────┼─────┼──────┼──"]
[0.005, "o", "───────────────┤\r\u001b[2C\u001b[1B│ Vertical Tab (VT)    │ 11  │ 0x0B │ \u001b[38;5;153m\\v\u001b[39m              │\r\u001b[2C\u001b[1B├──────────────────────┼─────┼──────┼─────────────────┤\r\u001b[2C\u001b[1B│ Form Feed (FF)       │ 12  │ 0x0C │ \u001b[38;5;153m\\f\u001b[39m              │\r\u001b[2C\u001b[1B├──────────────────────┼─────┼──────┼─────────────────┤\r\u001b[2C\u001b[1B│ Carriage Return (CR) │ 13  │ 0x0D │ \u001b[38;5;153m\\r\u001b[39m              │\r\u001b[2C\u001b[1B├──────────────────────┼─────┼──────┼─────────────────┤\r\u001b[2C\u001b[1B│ Space (SP) \u001b[17G    \u001b[22G   \u001b[26G│ 32  │ 0x20 │ \u001b[38;5;153m' '\u001b[39m (no\u001b[49Gescape) │\u001b[K\r\u001b[2C\u001b[1B└─────────────────────"]
[0.001, "o", "─┴─────┴──────┴─────────────────┘\u001b[59G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese\u001b[9Gsix\u001b[13Gare\u001b[17Gwhat\u001b[22GC's\u001b[26G\u001b[38;5;153misspace()\u001b[36G\u001b[39mand\u001b[40Gregex\u001b[46G\u001b[38;5;153m\\s\u001b[49G\u001b[39mmatch\u001b[55Gin\u001b[58GASCII.\u001b[65GSome\u001b[70Gcontexts\u001b[79Galso\u001b[84Gtreat\u001b[90Gthe\r\u001b[1B \u001b[3Gseparators 28–31 (0x1C–0x1F) as\u001b[35Gwhitespace,\u001b[47Gfor\u001b[51Gexample\u001b[59GPython's\u001b[68G\u001b[38;5;153mstr.isspace()\u001b[82G\u001b[39mand\u001b[86GJava's\r\u001b[2C\u001b[1B\u001b[38;5;153mCharacter.isWhitespace\u001b[39m.\u001b[27GThey\u001b[32Ghave\u001b[37Gno\u001b[40Gstandard\u001b[49Gescapes.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m✻\u001b[3GCrunched for 3s · done 12:49 PM\u001b[95G\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mUnrelated: in one sentence, why do Windows text files end lines with CRLF?\u001b[39m                        \r\u001b[2C\u001b[1B\u001b[49m   \u001b[7G      \u001b[14G  \u001b[17G    \u001b[22G    \u001b[27G      \u001b[34G  \u001b[37G     \u001b[43G \u001b[45G   \u001b[49G     \u001b[95G\u001b[1m[ 📌 ]\r\u001b[1B\u001b[22m\u001b[38;5;231m⏺\u001b[3G\u001b[39mWindows\u001b[11Ginherited\u001b[21GCRLF\u001b[26Gfrom\u001b[31GMS-DOS,\u001b[39Gwhich\u001b[45Ginherited\u001b[55Git\u001b["]
[0.001, "o", "58Gfrom\u001b[63GCP/M,\u001b[69Gwhich\u001b[75Gcopied\r\u001b[1B \u001b[3Gteletype-style printers where CR\u001b[36Greturned\u001b[45Gthe\u001b[49Gcarriage\u001b[58Gto\u001b[61Gthe\u001b[65Gleft\u001b[70Gmargin\u001b[77Gand\u001b[81GLF\u001b[84Gadvanced\r\u001b[2C\u001b[1Bthe\u001b[7Gpaper,\u001b[14Gso\u001b[17Gboth\u001b[22Gwere\u001b[27Gneeded\u001b[34Gto\u001b[37Gstart\u001b[43Ga\u001b[45Gnew\u001b[49Gline.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m✻\u001b[3GChurned for 2s · done 12:49 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mAnd in one sentence, how do I make cat show tabs visibly?\u001b[39m                                         \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;5;246m✻\u001b[39m \u001b[38;5;246mSautéed\u001b[11Gfor 1s · done 12:49 PM\u001b[39m\u001b[K\r\u001b[4B❯ \r\u001b[41C\u001b[2B\u001b[38;5;246m← 3\u001b[46Gagents\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
[0.007, "o", "\u001b[?2026h\u001b[?25l\u001b[H\u001b[3G│\u001b[5GHorizontal\u001b[16GTab\u001b[20G(HT)\u001b[26G│\u001b[28G9\u001b[32G│\u001b[34G0x09\u001b[39G│\u001b[41G\u001b[38;5;153m\\t\u001b[57G\u001b[39m│\u001b[94G\u001b[K\r\u001b[1B \u001b[3G├\u001b[26G┼\u001b[32G┼\u001b[39G┼\u001b[57G┤\r\u001b[4C\u001b[1BLine\u001b[10GFeed (LF)\u001b[28G10 \u001b[34G0x0A\u001b[41G\u001b[38;5;153m\\n\u001b[45G\u001b[39m      \r\u001b[4C\u001b[2BVe\u001b[8Gtical Tab (VT)  \u001b[28G11\u001b[37GB\u001b[42G\u001b[38;5;153mv\r\u001b[4C\u001b[2B\u001b[39mForm\u001b[16GF\u001b[29G2\u001b[37GC\u001b[42G\u001b[38;5;153mf\r\u001b[4C\u001b[2B\u001b[39mCa\u001b[8Gr\u001b[10Gage\u001b[14GReturn (CR)\u001b[29G3\u001b[37GD\u001b[42G\u001b[38;5;153mr\r\u001b[4C\u001b[2B\u001b[39mSpace (SP)    \u001b[28G3\u001b[36G20\u001b[41G\u001b[38;5;153m' '\u001b[45G\u001b[39m(no\u001b[49Gescape)\r\u001b[2C\u001b[1B└\u001b[26G┴\u001b[32G┴\u001b[39G┴\u001b[57G┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese six are what C's \u001b[38;5;153misspace()\u001b[39m and regex \u001b[38;5;153m\\s\u001b[39m match in ASCII.\u001b[65GSome\u001b[70Gcontexts\u001b[79Galso\u001b[84Gtreat\u001b[90Gthe\r\u001b[2C\u001b[1Bseparators 28–31\u001b[20G(0x1C–0x1F)\u001b[32Gas whitespace, for example\u001b[59GPython's\u001b[68G\u001b[38;5;153mstr.isspace()\u001b[82G\u001b[39mand\u001b[86GJava's\r\u001b[2C\u001b[1B\u001b[38;5;153mCharacter.isWhitespace\u001b[39m. They have no standard escapes.\u001b[K\r\u001b[2B\u001b[38;5;246m✻\u001b[3GCrunched for 3s · done 12:49 PM\u001b[39m\u001b[K\r"]
[0.001, "o", "\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mUnrelated: in one sentence, why do Windows text files end lines with CRLF?\u001b[39m                        \r\u001b[94C\u001b[1B\u001b[49m\u001b[1m[ 📌 ]\r\u001b[1B\u001b[22m\u001b[38;5;231m⏺\u001b[3G\u001b[39mWindows inherited CRLF from MS-DOS,\u001b[39Gwhich\u001b[45Ginherited\u001b[55Git\u001b[58Gfrom\u001b[63GCP/M,\u001b[69Gwhich\u001b[75Gcopied\r\u001b[2C\u001b[1Bteletype-style\u001b[18Gprinters\u001b[27Gwhere\u001b[33GCR\u001b[36Greturned\u001b[45Gthe\u001b[49Gcarriage\u001b[58Gto\u001b[61Gthe\u001b[65Gleft\u001b[70Gmargin\u001b[77Gand\u001b[81GLF\u001b[84Gadvanced\r\u001b[1B  the paper, so both were needed to start a new line.\u001b[K\r\u001b[94C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m✻\u001b[3GChurned for 2s · done 12:49 PM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mAnd in one sentence, how do I make cat show tabs visibly?\u001b[39m                                         \r\u001b[94C\u001b[1B\u001b[49m\u001b[1m[ 📌 ]\r\u001b[1B\u001b[22m\u001b[38;5;231m⏺\u001b[3G\u001b[39mUse \u001b[38;5;153mcat -T file\u001b[39m on GNU/Linux (tabs\u001b[38Gshow\u001b[43Gas\u001b[46G\u001b[38;5;153m^I\u001b[39m),\u001b[51Gor\u001b[54G\u001b[38;5;153mcat -t file\u001b[66G\u001b[39mon\u001b[69GmacOS/BSD,\u001b[80Gwhich\u001b[86Galso\r\u001b[2C\u001b[1Bmakes\u001b[9Gother\u001b[15G"]

[0.001, "o", "ce()\u001b[82G\u001b[39mand\u001b[86GJava's\u001b[95G\u001b[K\r\u001b[1B \u001b[3G\u001b[38;5;153mCharac\u001b[10Ger.isWhitespace\u001b[39m. They\u001b[32Ghave no standard escapes.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m✻\u001b[3GCrunched for 3s · done 12:49 PM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mUnrelated: in one sentence, why do Windows text files end lines with CRLF?\u001b[39m                        \r\u001b[94C\u001b[1B\u001b[49m\u001b[1m[ 📌 ]\r\u001b[1B\u001b[22m\u001b[38;5;231m⏺\u001b[39m Windows inherited CRLF from MS-DOS, which inherited it from CP/M, which copied\u001b[K\r\u001b[2C\u001b[1Bteletype-style\u001b[18Gprinters\u001b[27Gwhere\u001b[33GCR\u001b[36Greturned\u001b[45Gthe\u001b[49Gcarriage\u001b[58Gto\u001b[61Gthe\u001b[65Gleft\u001b[70Gmargin\u001b[77Gand\u001b[81GLF\u001b[84Gadvanced\u001b[95G\u001b[K\r\u001b[1B \u001b[3Gthe paper, so both were need\u001b[32Gd to start a new\u001b[49Gline.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m✻\u001b[3GChurned for 2s · done 12:49 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mAnd in one sentence, how do I make cat show tabs visibly?\u001b[39m                                         \r\u001b[1B\u001b[49m                                                       \u001b[95G\u001b[1m[ 📌 ]\r\u001b["]
[0.001, "o", "1B\u001b[22m\u001b[38;5;231m⏺\u001b[3G\u001b[39mUse\u001b[7G\u001b[38;5;153mcat -T file\u001b[19G\u001b[39mon\u001b[22GGNU/Linux\u001b[32G(tabs show\u001b[43Ga\u001b[45G \u001b[38;5;153m^I\u001b[39m),\u001b[51Gor\u001b[54G\u001b[38;5;153mcat -t file\u001b[66G\u001b[39mon\u001b[69GmacOS/BSD,\u001b[80Gwhich\u001b[86Galso\r\u001b[1B  makes other control characters visible. If you also want\u001b[60Gline\u001b[65Gendings\u001b[73Gmarked\u001b[80Gwith\u001b[85G\u001b[38;5;153m$\u001b[39m,\u001b[88Guse\u001b[92G\u001b[38;5;153mcat\r\u001b[1B\u001b[39m \u001b[3G\u001b[38;5;153m-A file\u001b[39m (GNU) or \u001b[38;5;153mcat -et file\u001b[39m (macOS).\u001b[55G\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m✻\u001b[3GSautéed for 1s · done 12:49 PM\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mOne more: in one sentence, what does dos2unix do?\u001b[39m                                                 \r\u001b[1B\u001b[49m                                                       \u001b[95G\u001b[1m[ 📌 ]\r\u001b[1B\u001b[22m\u001b[38;5;231m⏺\u001b[3G\u001b[38;5;153mdos2unix\u001b[39m converts\u001b[21Ga\u001b[23Gtext file's Windows-style\u001b[49GCRLF\u001b[54Gline\u001b[59Gendings\u001b[67Gto\u001b[70GUnix-style\u001b[81GLF\u001b[84G(it\u001b[88Gstrips\r\u001b[1B  the \u001b[38;5;153m\\r\u001b[39m), and its counterpart \u001b[38;5;153munix2dos\u001b[39m does th"]

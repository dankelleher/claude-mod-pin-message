[0.003, "o", "────────────┼─────┼──────┼─────────────────┤\r\u001b[2C\u001b[1B│ Horizontal Tab (HT)  │ 9   │ 0x09 │ \u001b[38;5;153m\\t\u001b[39m              │\r\u001b[2C\u001b[1B├──────────────────────┼─────┼──────┼─────────────────┤\r\u001b[2C\u001b[1B│ Line Feed (LF)       │ 10  │ 0x0A │ \u001b[38;5;153m\\n\u001b[39m              │\r\u001b[2C\u001b[1B├──────────────────────┼─────┼──────┼─────────────────┤\r\u001b[2C\u001b[1B│ Vertical Tab (VT)    │ 11  │ 0x0B │ \u001b[38;5;153m\\v\u001b[39m              │\r\u001b[2C\u001b[1B├──────────────────────┼─────┼──────┼─────────────────┤\r\u001b[2C\u001b[1B│ Form Feed (FF)       │ 12  │ 0x0C │ \u001b[38;5;153m\\f\u001b[39m              │\r\u001b[2C\u001b[1B"]
[0.001, "o", "├──────────────────────┼─────┼──────┼─────────────────┤\r\u001b[2C\u001b[1B│ Carriage Return (CR) │ 13  │ 0x0D │ \u001b[38;5;153m\\r\u001b[39m              │\r\u001b[2C\u001b[1B├──────────────────────┼─────┼──────┼─────────────────┤\r\u001b[2C\u001b[1B│ Space (SP)           │ 32  │ 0x20 │ \u001b[38;5;153m' '\u001b[39m (no escape) │\r\u001b[2C\u001b[1B└──────────────────────┴─────┴──────┴─────────────────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThese\u001b[9Gsix\u001b[13Gare\u001b[17Gwhat\u001b[22GC's\u001b[26G\u001b[38;5;153misspace()\u001b[36G\u001b[39mand\u001b[40Gregex\u001b[46G\u001b[38;5;153m\\s\u001b[49G\u001b[39mmatch\u001b[55Gin\u001b[58GASCII.\u001b[65GSome\u001b[70Gcontexts\u001b[79Galso\u001b[84Gtreat\u001b[90Gthe\r\u001b[2C\u001b[1Bseparators 28–31 (0x1C–0x1F) as whitespace, for example Python's \u001b[38;5;153mstr.isspace()\u001b[39m and J\u001b[88Gva's\u001b[K\r\u001b"]
[0.001, "o", "[2C\u001b[1B\u001b[38;5;153mCharacter.isWhitespace\u001b[39m. They\u001b[32Ghave no \u001b[41Gt\u001b[43Gndard escapes.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m✻\u001b[3GCrunched for 3s · done 12:49 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;5;237m\u001b[38;5;246m❯ \u001b[38;5;231mUnrelated: in one sentence, why do Windows text files end lines with CRLF?\u001b[39m                        \r\u001b[2B\u001b[49m\u001b[38;5;174m✢\u001b[3GPouncing… \r\u001b[1B\u001b[38;5;246m  ⎿  Tip: Did you know you can drag and drop image files into your terminal?\r\u001b[4B❯ \u001b[39m\u001b[K\r\u001b[38C\u001b[2B\u001b[38;5;246m · esc to interrupt · ← 3 agents\u001b[39m\u001b[40;1H\u001b[38;3H\u001b[?25h\u001b[?2026l"]
